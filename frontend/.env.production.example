# Production Environment Variables for OpenRepoWiki Frontend
# Copy this file to .env.production and set the API URL before building

# API Gateway URL - REQUIRED for production builds
# This should be your deployed API Gateway invoke URL
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com/v1
VITE_API_URL=https://your-api-gateway-url.execute-api.region.amazonaws.com/v1
